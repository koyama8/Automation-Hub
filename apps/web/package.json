{
  "name": "qa-automation-lab-web",
  "version": "0.1.0",
  "private": true,
  "description": "Interface web local para automacao com Cypress.",
  "scripts": {
    "dev": "serve -s dist -p 3000",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:run:bdd": "cypress run --config \"specPattern=cypress/e2e/features/**/*.feature\"",
    "cypress:run:bdd:smoke": "cypress run --config \"specPattern=cypress/e2e/features/**/*.feature\" --env tags=\"@smoke\"",
    "cypress:run:bdd:regression": "cypress run --config \"specPattern=cypress/e2e/features/**/*.feature\" --env tags=\"@regression\"",
    "cypress:run:bdd:negative": "cypress run --config \"specPattern=cypress/e2e/features/**/*.feature\" --env tags=\"@negative\"",
    "lint:bdd": "eslint \"cypress/e2e/step_definitions/**/*.js\" \"cypress/support/**/*.js\"",
    "format:bdd": "prettier --write \"cypress/e2e/features/**/*.feature\" \"cypress/e2e/step_definitions/**/*.js\" \"cypress/support/**/*.js\"",
    "format:check:bdd": "prettier --check \"cypress/e2e/features/**/*.feature\" \"cypress/e2e/step_definitions/**/*.js\" \"cypress/support/**/*.js\"",
    "quality:check": "npm run lint:bdd && npm run format:check:bdd"
  },
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": "cypress/e2e/step_definitions/**/*.{js,mjs,ts,tsx}",
    "filterSpecs": true,
    "messages": {
      "enabled": true,
      "output": "cypress/reports/cucumber/messages.ndjson"
    },
    "json": {
      "enabled": true,
      "output": "cypress/reports/cucumber/cucumber-report.json"
    },
    "html": {
      "enabled": true,
      "output": "cypress/reports/cucumber/index.html"
    },
    "attachments": {
      "addScreenshots": true,
      "addVideos": false
    }
  },
  "dependencies": {
    "serve": "^14.2.4"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^26.0.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "@faker-js/faker": "^10.5.0",
    "cypress": "^14.1.0",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "prettier-plugin-gherkin": "^4.0.0"
  }
}
