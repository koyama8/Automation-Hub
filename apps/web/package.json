{
  "name": "qa-automation-lab-web",
  "version": "0.1.0",
  "private": true,
  "description": "Interface web local para automacao com Cypress.",
  "scripts": {
    "dev": "serve -s dist -p 3000",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:run:bdd": "cypress run --config \"specPattern=cypress/e2e/features/*.feature\""
  },
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": "cypress/e2e/step_definitions/**/*.{js,mjs,ts,tsx}",
    "messages": {
      "enabled": true,
      "output": "cypress/reports/cucumber/messages.ndjson"
    },
    "json": {
      "enabled": true,
      "output": "cypress/reports/cucumber/cucumber-report.json"
    },
    "html": {
      "enabled": true,
      "output": "cypress/reports/cucumber/index.html"
    },
    "attachments": {
      "addScreenshots": true,
      "addVideos": false
    }
  },
  "dependencies": {
    "serve": "^14.2.4"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^26.0.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "@faker-js/faker": "^10.5.0",
    "cypress": "^14.1.0"
  }
}
