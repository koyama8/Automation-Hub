{
  "name": "qa-automation-lab-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "description": "API REST local para estudos de QA Automation com Express, Prisma e PostgreSQL.",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "node --env-file=.env ../../database/seed/seed-admin.js",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:run:bdd": "cypress run --config \"specPattern=cypress/e2e/features/**/*.feature\"",
    "cypress:run:bdd:smoke": "cypress run --config \"specPattern=cypress/e2e/features/**/*.feature\" --env tags=\"@smoke\"",
    "cypress:run:bdd:regression": "cypress run --config \"specPattern=cypress/e2e/features/**/*.feature\" --env tags=\"@regression\"",
    "cypress:run:bdd:negative": "cypress run --config \"specPattern=cypress/e2e/features/**/*.feature\" --env tags=\"@negative\""
  },
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": "cypress/e2e/step_definitions/**/*.{js,mjs,ts,tsx}",
    "filterSpecs": true,
    "messages": {
      "enabled": true,
      "output": "cypress/reports/cucumber/messages.ndjson"
    },
    "json": {
      "enabled": true,
      "output": "cypress/reports/cucumber/cucumber-report.json"
    },
    "html": {
      "enabled": true,
      "output": "cypress/reports/cucumber/index.html"
    },
    "attachments": {
      "addScreenshots": true,
      "addVideos": false
    }
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.21.0",
    "prisma": "^7.8.0"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^22.0.1",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "@faker-js/faker": "^10.4.0",
    "cypress": "^14.3.1",
    "cypress-plugin-api": "^2.11.2",
    "nodemon": "^3.1.14",
    "pg-promise": "^12.6.2"
  }
}
